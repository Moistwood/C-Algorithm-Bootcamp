# 复制为 .env 后按需修改。所有变量都有默认值，不改也能跑。

# ---------- 基本信息 ----------
ALGO_DEBUG=true

# ---------- 数据库 ----------
# 默认 SQLite（runtime/app.db），换 MySQL/PostgreSQL 时改成连接串即可
# ALGO_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/algo
# ALGO_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/algo

# ---------- 安全 ----------
# 留空即可：首次启动会生成随机密钥并写到 runtime/secret.key，重启后沿用。
# 多实例部署时把同一个值填进来，让各实例签发/校验的 token 互通。
# ALGO_SECRET_KEY=
ALGO_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 评测 ----------
ALGO_JUDGE_ENABLED=true
ALGO_JUDGE_DEFAULT_TIME_LIMIT=2000
ALGO_JUDGE_MAX_CONCURRENT=2
ALGO_JUDGE_CPP_STANDARD=c++14
ALGO_JUDGE_OPTIMIZE=-O2

# 提交限流：同一用户两次提交的最小间隔（秒）、每分钟最多提交几次
ALGO_JUDGE_SUBMIT_INTERVAL=3
ALGO_JUDGE_SUBMIT_PER_MINUTE=12

# 留空自动探测；手动指定示例：
# ALGO_GPP_PATH=C:/msys64/mingw64/bin/g++.exe

# ---------- 跨域 ----------
# 生产环境建议改成具体域名，逗号分隔
ALGO_CORS_ORIGINS=*
